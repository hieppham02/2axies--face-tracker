--cpu Cortex-M3
"robot-arm_demo\startup_stm32f103xb.o"
"robot-arm_demo\main.o"
"robot-arm_demo\stm32f1xx_it.o"
"robot-arm_demo\stm32f1xx_hal_msp.o"
"robot-arm_demo\stm32f1xx_hal_gpio_ex.o"
"robot-arm_demo\stm32f1xx_hal_adc.o"
"robot-arm_demo\stm32f1xx_hal_adc_ex.o"
"robot-arm_demo\stm32f1xx_hal.o"
"robot-arm_demo\stm32f1xx_hal_rcc.o"
"robot-arm_demo\stm32f1xx_hal_rcc_ex.o"
"robot-arm_demo\stm32f1xx_hal_gpio.o"
"robot-arm_demo\stm32f1xx_hal_dma.o"
"robot-arm_demo\stm32f1xx_hal_cortex.o"
"robot-arm_demo\stm32f1xx_hal_pwr.o"
"robot-arm_demo\stm32f1xx_hal_flash.o"
"robot-arm_demo\stm32f1xx_hal_flash_ex.o"
"robot-arm_demo\stm32f1xx_hal_exti.o"
"robot-arm_demo\stm32f1xx_hal_tim.o"
"robot-arm_demo\stm32f1xx_hal_tim_ex.o"
"robot-arm_demo\stm32f1xx_hal_uart.o"
"robot-arm_demo\system_stm32f1xx.o"
--strict --scatter "Robot-Arm_Demo\Robot-Arm_Demo.sct"
--summary_stderr --info summarysizes --map --load_addr_map_info --xref --callgraph --symbols
--info sizes --info totals --info unused --info veneers
--list "Robot-Arm_Demo.map" -o Robot-Arm_Demo\Robot-Arm_Demo.axf